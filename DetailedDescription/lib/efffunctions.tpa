	END

	PATCH_IF opcode == 97 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~力量18时尾数修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~力量18时尾数设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~力量18时尾数设为现有的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 98 BEGIN
		PATCH_IF location == 2 THEN BEGIN SET readpara4 = (readpara4 == 0)? 1 : readpara4 END ELSE BEGIN SET readpara4 = 1 END
		PATCH_IF (readamount != 0)&&(readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~每秒再生1HP~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN
			PATCH_IF (readpara4 != 0) BEGIN
				SPRINT effdesc ~%effdesc%~^~每秒再生1HP~ SET descfixed = 1
			END ELSE BEGIN
				PATCH_IF (readamount < 100) BEGIN
					SPRINT effdesc ~%effdesc%~^~每秒再生1HP~ SET descfixed = 1
				END
				PATCH_IF (readamount > 99)&&(readamount < 256) BEGIN
					SPRINT effdesc ~%effdesc%~^~生物HP>100／%readamount%时每秒再生1HP~ SET descfixed = 1
				END
			END
		END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~每%readpara4%秒再生%readamount%HP~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~每%readamount%×%readpara4%秒再生1HP~ SET descfixed = 1 END
		PATCH_IF (readtype == 4)&&(location == 2) BEGIN SPRINT effdesc ~%effdesc%~^~每%readamount%×%readpara4%秒再生%readpara3%HP~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 99 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~奥术持续时间设为：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~神术持续时间设为：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~战歌持续时间设为：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 100 BEGIN
		SPRINT effdesc ~%effdesc%~^~防护生物类型：~ SET descfixed = 1
		PATCH_MATCH readtype
		WITH
			2 BEGIN SPRINT effdesc ~%effdesc%~^~（敌友类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~EA~ readamount END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~（一般类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~General~ readamount END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~（种族类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Race~ readamount END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~（职业类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Class~ readamount END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~（特殊类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Specific~ readamount END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~（性别类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Gender~ readamount END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~（阵营类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Align~ readamount END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~（宗派类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Kit~ readamount END
			DEFAULT SPRINT effdesc ~%effdesc%~^~（错误的类型代码）~ SPRINT idsentry ~~
		END
		SPRINT effdesc ~%effdesc%~^~%idsentry%~
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 101 BEGIN
		SPRINT effdesc ~%effdesc%~^~防护效果条目：~ SET descfixed = 1
		INNER_ACTION BEGIN
			COPY ~DetailedDescription\2da\dopcodes.2da~ ~override~
				COUNT_2DA_ROWS 2 maxrows
				FOR ( index = 0 ; index < maxrows ; index = index + 1 ) BEGIN
					READ_2DA_ENTRY index 0 2 readopcode
					READ_2DA_ENTRY index 1 2 readopcodename
					PATCH_IF readopcode == readtype BEGIN
						SPRINT effdesc ~%effdesc%~^~%readopcodename%~
						SET index = maxrows + 1
					END
				END
				PATCH_IF index < maxrows BEGIN
					SPRINT effdesc ~%effdesc%~^~效果编号超出范围（#%readtype%）~
				END
			BUT_ONLY
		END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 102 BEGIN
		SPRINT effdesc ~%effdesc%~^~免疫%readamount%级法术~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END


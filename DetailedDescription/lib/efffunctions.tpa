	END
	PATCH_IF opcode == 128 BEGIN
		SPRINT effdesc ~%effdesc%~^~困惑~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 129 BEGIN
		SET readspecial = readamount BAND 0xff	//命中伤害豁免修正仅看第一字节
		PATCH_IF (readamount > 0) BEGIN
			PATCH_IF location != 2 THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~援助：命中、伤害、豁免+%readspecial%有利，最大HP增加%readamount%D8~ SET descfixed = 1
			END ELSE BEGIN
				SPRINT effdesc ~%effdesc%~^~援助：命中、伤害、豁免+%readspecial%有利，最大HP增加%readtype%~ SET descfixed = 1
			END
		END
		PATCH_IF (readamount < 0) BEGIN SPRINT effdesc ~%effdesc%~^~反向援助：命中、伤害、豁免%readamount%不利~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 130 BEGIN
		SET readamount = readamount BAND 0xff
		SPRINT effdesc ~%effdesc%~^~祝福（命中伤害获得%readamount%修正，士气+5）~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 131 BEGIN

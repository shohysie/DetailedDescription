			17 BEGIN SPRINT effdesc ~%effdesc%~^~守序善良~ END
			18 BEGIN SPRINT effdesc ~%effdesc%~^~守序中立~ END
			19 BEGIN SPRINT effdesc ~%effdesc%~^~守序邪恶~ END

		SPRINT effdesc ~%effdesc%~^~群体复活队员~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 305 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~副手命中修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~副手命中设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~副手命中设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 306 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~主手命中修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~主手命中设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~主手命中设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 309 BEGIN
		PATCH_IF STRING_LENGTH ~%readres%~ > 0 THEN BEGIN
			PATCH_IF location == 2 THEN BEGIN
				PATCH_IF STRING_LENGTH ~%readres2%~ > 0 THEN BEGIN SPRINT readres ~readres~^~readres2~ END
				PATCH_IF STRING_LENGTH ~%readres3%~ > 0 THEN BEGIN SPRINT readres ~readres~^~readres3~ END
			END
			PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~设置局部变量%readres%的值为%readamount%~ SET descfixed = 1 END
			PATCH_IF (readtype == 1) BEGIN
				PATCH_IF readamount > "-1" THEN BEGIN
					SPRINT effdesc ~%effdesc%~^~局部变量%readres%的值＋%readamount%~ SET descfixed = 1
				END ELSE BEGIN
					SPRINT effdesc ~%effdesc%~^~局部变量%readres%的值%readamount%~ SET descfixed = 1
				END
			END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 310 BEGIN
		PATCH_IF (readtype != 0) BEGIN
			SPRINT effdesc ~%effdesc%~^~免疫时间停止~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 311 BEGIN
		SPRINT effdesc ~%effdesc%~^~随机许愿~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 316 BEGIN
		SPRINT effdesc ~%effdesc%~^~魔法休息~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF (opcode == 318)||(opcode == 324) BEGIN
		PATCH_IF (location == 0)&&(NOT ~%SOURCE_FILE%~ STRING_COMPARE_CASE ~%readres%.spl~) THEN BEGIN SET descfixed = 9 END	//标记目标法术是当前法术本身
		SPRINT effdesc ~%effdesc%~^~满足特定条件~
		INNER_ACTION BEGIN
			COPY_EXISTING ~splprot.2da~ ~override~
				COUNT_2DA_ROWS 4 maxrows
				PATCH_IF readtype < maxrows BEGIN	//splprot.2da中第几行
					LPF CHECK_SPLPROT_DESC INT_VAR chkprotline = readtype RET chkprotdesc END
					SPRINT effdesc ~%effdesc%~^~%chkprotdesc%时防护特定法术／物品效果：~
				END
			BUT_ONLY
		END
		PATCH_IF descfixed == 9 THEN BEGIN	//目标法术是当前法术本身		
			SPRINT effdesc ~%effdesc%~^~(法术效果)当前法术本身~ SET descfixed = 1
		END ELSE BEGIN		
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
			PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的法术~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知法术~)||(detailed > 0))) BEGIN
				SPRINT effdesc ~%effdesc%~^~(法术效果)%namestr%~ SET descfixed = 1
				PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
				PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
			END
		END
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN SPRINT effdesc ~%effdesc%~^~(物品效果)%namestr%~ SET descfixed = 2 END
		PATCH_IF (descfixed > 0) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF (opcode == 319)&&(location == 1) BEGIN
		READ_BYTE (3 + effoffset + 0x30 * (firsteff + effectnum - 1)) readpower
		PATCH_IF (readpower == 0) BEGIN SPRINT effdesc ~%effdesc%~^~禁止生物类型使用本物品：~ SET descfixed = 1 END
		PATCH_IF (readpower == 1) BEGIN SPRINT effdesc ~%effdesc%~^~限定生物类型使用本物品：~ SET descfixed = 1 END
		PATCH_MATCH readtype
		WITH
			2 BEGIN SPRINT effdesc ~%effdesc%~^~（敌友类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~EA~ readamount END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~（一般类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~General~ readamount END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~（种族类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Race~ readamount END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~（职业类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Class~ readamount END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~（特殊类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Specific~ readamount END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~（性别类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Gender~ readamount END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~（阵营类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Align~ readamount END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~（宗派类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Kit~ readamount END
			10 BEGIN
				PATCH_IF (readpower == "-1") BEGIN
					SPRINT idsentry ~主角~
				END ELSE BEGIN
					GET_STRREF readpower idsentry
					SPRINT idsentry ~生物名称为%idsentry%~ 
				END
			END
			11 BEGIN			
				PATCH_IF ((STRING_LENGTH ~%readres%~) == 0) BEGIN
					SPRINT idsentry ~主角~
				END ELSE BEGIN
					SPRINT idsentry ~生物代码为%readres%~ 
				END
			END
			DEFAULT SPRINT effdesc ~%effdesc%~^~（错误的类型代码）~ SPRINT idsentry ~~
		END
		SPRINT effdesc ~%effdesc%~^~%idsentry%~
		PATCH_IF (descfixed > 0) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 320 BEGIN
		PATCH_IF (readamount == 0) BEGIN SPRINT effdesc ~%effdesc%~^~改变天气：晴~ SET descfixed = 1 END
		PATCH_IF (readamount == 1) BEGIN SPRINT effdesc ~%effdesc%~^~改变天气：雨（需在游戏选项中开启天气）~ SET descfixed = 1 END
		PATCH_IF (readamount == 2) BEGIN SPRINT effdesc ~%effdesc%~^~改变天气：雪（需在游戏选项中开启天气）~ SET descfixed = 1 END
		PATCH_IF (readamount == 3) BEGIN SPRINT effdesc ~%effdesc%~^~改变天气：雾（需在游戏选项中开启天气）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 321 BEGIN
		SPRINT effdesc ~%effdesc%~^~移除特定法术／物品等效果：~
		PATCH_IF (location == 0)&&(NOT ~%SOURCE_FILE%~ STRING_COMPARE_CASE ~%readres%.spl~) THEN BEGIN	//目标法术是当前法术本身
			SPRINT effdesc ~%effdesc%~^~(法术效果)当前法术本身~ SET descfixed = 1
		END ELSE BEGIN
			PATCH_IF (FILE_EXISTS_IN_GAME ~%readres%.spl~)&&((readtype == 0)||(readtype == 2)) BEGIN
				LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END	//如果法术文件等于源文件，则不显示详细
				SPRINT effdesc ~%effdesc%~^~(法术效果)%namestr%~ SET descfixed = 1
				PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
				PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
			END
		END
		PATCH_IF (FILE_EXISTS_IN_GAME ~%readres%.itm~)&&((readtype == 0)||(readtype == 1)) BEGIN
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr END
			SPRINT effdesc ~%effdesc%~^~(物品效果)%namestr%~
			SET descfixed = 2
		END
		PATCH_IF (descfixed > 0) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 322 BEGIN
		SPRINT effdesc ~%effdesc%~^~规避范围效果（遇到经特殊豁免设置的效果才生效）~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 323 BEGIN
		PATCH_IF (readtype == 0)&&(readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~超度等级修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1)&&(readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~超度等级设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~超度等级随目标最高等级提升~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 325 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~所有豁免修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~所有豁免设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~所有豁免设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 326 BEGIN
		SPRINT effdesc ~%effdesc%~^~满足特定条件~
		INNER_ACTION BEGIN
			COPY_EXISTING ~splprot.2da~ ~override~
				COUNT_2DA_ROWS 4 maxrows
				PATCH_IF readtype < maxrows BEGIN	//splprot.2da中第几行
					LPF CHECK_SPLPROT_DESC INT_VAR chkprotline = readtype RET chkprotdesc END
					SPRINT effdesc ~%effdesc%~^~%chkprotdesc%时应用特定法术：~
				END
			BUT_ONLY
		END
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
		SPRINT effdesc ~%effdesc%~^~%namestr%~ SET descfixed = 1
		PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
		PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 328 BEGIN
		PATCH_IF readspecial == 0 BEGIN
			PATCH_MATCH readtype
			WITH
				0 BEGIN SPRINT idsentry ~混乱命令~ SET descfixed = 1 END
				1 BEGIN SPRINT idsentry ~施法失败~ SET descfixed = 1 END
				2 BEGIN SPRINT idsentry ~痛苦~ SET descfixed = 1 END
				3 BEGIN SPRINT idsentry ~毒咒~ SET descfixed = 1 END
				4 BEGIN SPRINT idsentry ~血怒~ SET descfixed = 1 END
				5 BEGIN SPRINT idsentry ~猫之优雅~ SET descfixed = 1 END
				6 BEGIN SPRINT idsentry ~霉菌之触~ SET descfixed = 1 END
				7 BEGIN SPRINT idsentry ~火焰之袍~ SET descfixed = 1 END
				DEFAULT SET descfixed = 0
			END
		END
		PATCH_IF readspecial == 1 BEGIN LOOKUP_IDS_SYMBOL_OF_INT idsentry ~splstate~ readtype END
		PATCH_IF NOT IS_AN_INT idsentry THEN BEGIN
			SET descfixed = 1		
			SPRINT effdesc ~%effdesc%~^~设置状态：%idsentry%~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 329 BEGIN
		SPRINT effdesc ~%effdesc%~^~减缓毒发~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 331 BEGIN
		SPRINT effdesc ~%effdesc%~^~随机生物召唤~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 332 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~所有类型伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~火焰伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~寒冷伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~电击伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~强酸伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~魔法伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 6) BEGIN SPRINT effdesc ~%effdesc%~^~毒素伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 7) BEGIN SPRINT effdesc ~%effdesc%~^~挥砍伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 8) BEGIN SPRINT effdesc ~%effdesc%~^~穿刺伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 9) BEGIN SPRINT effdesc ~%effdesc%~^~钝击伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 10) BEGIN SPRINT effdesc ~%effdesc%~^~远程伤害修正：%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 333 BEGIN
		SPRINT effdesc ~%effdesc%~^~静电荷（指定法术多次生效）~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 334 BEGIN
		SPRINT effdesc ~%effdesc%~^~施展超度~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 337 BEGIN
		SPRINT effdesc ~%effdesc%~^~移除效果条目：~ SET descfixed = 1
		INNER_ACTION BEGIN
			COPY ~DetailedDescription\2da\dopcodes.2da~ ~override~
				COUNT_2DA_ROWS 2 maxrows
				FOR ( index = 0 ; index < maxrows ; index = index + 1 ) BEGIN
					READ_2DA_ENTRY index 0 2 readopcode
					READ_2DA_ENTRY index 1 2 readopcodename
					PATCH_IF readopcode == readtype BEGIN
						SPRINT effdesc ~%effdesc%~^~%readopcodename%~
						SET index = maxrows + 1
					END
				END
				PATCH_IF index != (maxrows + 1) BEGIN
					SPRINT effdesc ~%effdesc%~^~超出范围的效果编号（#%readtype%）~
				END
			BUT_ONLY
		END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 338 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~禁止休息~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~禁止存档~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~禁止休息和存档~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 340 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF STRING_LENGTH ~%namestr%~ > 0 THEN BEGIN
			SPRINT effdesc ~%effdesc%~^~背刺成功施展法术：%namestr%~ SET descfixed = 1
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 341 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF STRING_LENGTH ~%namestr%~ > 0 THEN BEGIN		
			PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~致命一击（会被头盔和武器免疫阻挡）时施展指定法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~近战致命一击（会被头盔和武器免疫阻挡）时施展指定法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程致命一击（会被头盔和武器免疫阻挡）时施展指定法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 3) BEGIN SPRINT effdesc ~%effdesc%~^~法术致命一击（会被头盔和武器免疫阻挡）时施展指定法术：~ SET descfixed = 1 END
			SPRINT effdesc ~%effdesc%~^~%namestr%~
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
			PATCH_IF location == 2 THEN BEGIN
				PATCH_IF readpara3 > 0 THEN BEGIN
					LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara3
					SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
				END
			END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 343 BEGIN
		SPRINT effdesc ~%effdesc%~^~HP对调~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 344 BEGIN
		SPRINT effdesc ~%effdesc%~^~对生物类型：~ SET descfixed = 1
		PATCH_MATCH readtype
		WITH
			2 BEGIN SPRINT effdesc ~%effdesc%~^~（敌友类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~EA~ readamount END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~（一般类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~General~ readamount END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~（种族类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Race~ readamount END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~（职业类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Class~ readamount END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~（特殊类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Specific~ readamount END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~（性别类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Gender~ readamount END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~（阵营类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Align~ readamount END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~（宗派类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Kit~ readamount END
			DEFAULT SPRINT effdesc ~%effdesc%~^~（错误的类型代码）~ SPRINT idsentry ~~
		END
		PATCH_IF location == 2 THEN BEGIN
			PATCH_IF readpara3 == 0 THEN BEGIN SPRINT effdesc ~%effdesc%~^~（限当前武器）~ END
			PATCH_IF readpara3 == 1 THEN BEGIN SPRINT effdesc ~%effdesc%~^~（限主手武器）~ END
			PATCH_IF readpara3 == 2 THEN BEGIN SPRINT effdesc ~%effdesc%~^~（限副手武器）~ END
			PATCH_IF readpara3 == 3 THEN BEGIN SPRINT effdesc ~%effdesc%~^~（主副手武器皆有效）~ END
			PATCH_IF readpara4 > 0 THEN BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara4
				SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
			END
		END
		SPRINT effdesc ~%effdesc%~^~%idsentry%武器附魔等级视为%readspecial%~
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 345 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~武器附魔等级设为：＋%readamount%~ SET descfixed = 1 END
		PATCH_IF location == 2 THEN BEGIN
			PATCH_IF readpara4 > 0 THEN BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara4
				SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 346 BEGIN
		PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~对防护系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 2) BEGIN SPRINT effdesc ~%effdesc%~^~对咒法系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 3) BEGIN SPRINT effdesc ~%effdesc%~^~对预言系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 4) BEGIN SPRINT effdesc ~%effdesc%~^~对附魔系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 5) BEGIN SPRINT effdesc ~%effdesc%~^~对幻术系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 6) BEGIN SPRINT effdesc ~%effdesc%~^~对塑能系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 7) BEGIN SPRINT effdesc ~%effdesc%~^~对死灵系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 8) BEGIN SPRINT effdesc ~%effdesc%~^~对变化系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 9) BEGIN SPRINT effdesc ~%effdesc%~^~对所有系~ SET descfixed = 1 END
		PATCH_IF (readspecial == 10) BEGIN SPRINT effdesc ~%effdesc%~^~对狂乱系~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~的豁免修正：%readamount%~ END
			PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~的豁免设为：%readamount%~ END
			SET descfixed = 2
		END
		PATCH_IF (descfixed = 2) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 361 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF STRING_LENGTH ~%namestr%~ > 0 THEN BEGIN
			PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~致命失误时（忽略武器有效与否）对自身施展法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~近战致命失误时（忽略武器有效与否）对自身施展法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程致命失误时（忽略武器有效与否）对自身施展法术：~ SET descfixed = 1 END
			PATCH_IF (readspecial == 3) BEGIN SPRINT effdesc ~%effdesc%~^~法术致命失误时（忽略武器有效与否）对自身施展法术：~ SET descfixed = 1 END
			SPRINT effdesc ~%effdesc%~^~%namestr%~
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPWI~) BEGIN SPRINT effdesc ~%effdesc%~^~[法师]~ END
			PATCH_IF NOT (~%readres%~ STRING_CONTAINS_REGEXP ~SPPR~) BEGIN SPRINT effdesc ~%effdesc%~^~[牧师]~ END
			PATCH_IF location == 2 THEN BEGIN
				PATCH_IF readpara3 > 0 THEN BEGIN
					LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara3
					SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
				END
			END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 362 BEGIN
		PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~~ SET descfixed = 1 END
		PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~近战攻击~ SET descfixed = 1 END
		PATCH_IF (readspecial == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程攻击~ SET descfixed = 1 END
		PATCH_IF (readspecial == 3) BEGIN SPRINT effdesc ~%effdesc%~^~魔法攻击~ SET descfixed = 1 END
		PATCH_IF location == 2 THEN BEGIN
			PATCH_IF readpara3 > 0 THEN BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara3
				SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			SET critiacal = readamount * 5
			SPRINT effdesc ~%effdesc%~^~致命失误率修正：%critiacal%％~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 363 BEGIN
		LOOKUP_IDS_SYMBOL_OF_INT idsentry ~MODAL~ readspecial
		PATCH_IF NOT IS_AN_INT ~%idsentry%~ THEN BEGIN
			SPRINT effdesc ~%effdesc%~^~打破%idsentry%状态时终止本法术所有效果~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 366 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的法术~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知法术~)||(detailed > 0))) BEGIN
			SPRINT effdesc ~%effdesc%~^~移动时施展法术：%namestr%~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 367 BEGIN
		SPRINT effdesc ~%effdesc%~^~生物属性不会低于%readtype%~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

//如果没有添加opcode描述，输出空字符串
	PATCH_IF descfixed == 0 BEGIN
		SPRINT effdesc ~~
	END ELSE BEGIN
		PATCH_IF location == 2 THEN BEGIN
			SPRINT effdesc ~%effdesc%~^~}~
		END
	END

//PATCH_PRINT ~CHECK_ATTACK_EFFECT_output: %effdesc%~

END


	PATCH_IF opcode == 297 BEGIN
		PATCH_IF (readtype != 0) BEGIN
			SPRINT effdesc ~%effdesc%~^~免疫超度~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 299 BEGIN
		PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~狂乱魔法掷骰修正%readamount%（显示混乱护盾图标）~ SET descfixed = 1 END
		PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~狂乱魔法掷骰修正%readamount%（显示高级混乱护盾图标）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 301 BEGIN
		PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~~ SET descfixed = 1 END
		PATCH_IF (readspecial == 1) BEGIN SPRINT effdesc ~%effdesc%~^~近战攻击~ SET descfixed = 1 END
		PATCH_IF (readspecial == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程攻击~ SET descfixed = 1 END
		PATCH_IF (readspecial == 3) BEGIN SPRINT effdesc ~%effdesc%~^~魔法攻击~ SET descfixed = 1 END
		PATCH_IF location == 2 THEN BEGIN
			PATCH_IF readpara3 > 0 THEN BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ITEMCAT~ readpara3
				SPRINT effdesc ~%effdesc%~^~（武器类型限制：%idsentry%）~
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			SET critiacal = readamount * 5
			SPRINT effdesc ~%effdesc%~^~致命一击率修正：%critiacal%％~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 302 BEGIN
		PATCH_IF (readtype != 0) BEGIN
			SPRINT effdesc ~%effdesc%~^~万能巧手~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	
	PATCH_IF opcode == 303 BEGIN
		PATCH_IF (readtype & 0b00000001) = 0b00000001 BEGIN
			SPRINT effdesc ~%effdesc%~^~每击背刺，不需要隐形和位于敌人背后~ SET descfixed = 1
		END ELSE BEGIN
			PATCH_IF (readtype & 0b00000010) = 0b00000010 BEGIN
				SPRINT effdesc ~%effdesc%~^~每击背刺，不需要隐形~ SET descfixed = 1
			END ELSE BEGIN
				PATCH_IF (readtype & 0b00000100) = 0b00000100 BEGIN
					SPRINT effdesc ~%effdesc%~^~每击背刺，不需要位于敌人背后~ SET descfixed = 1
				END
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END



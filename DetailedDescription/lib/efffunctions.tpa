		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~移动速率修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~移动速率设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~移动速率设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~移动速率设为：当前的%readamount%％（可累加）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN

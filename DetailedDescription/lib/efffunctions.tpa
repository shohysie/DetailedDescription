		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~免疫非魔法武器~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~免疫银质武器~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~免疫非银质武器~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~免疫非银质或非魔法武器~ SET descfixed = 1 END
		PATCH_IF (readtype == 10) BEGIN SPRINT effdesc ~%effdesc%~^~免疫寒铁武器~ SET descfixed = 1 END
		PATCH_IF (readtype == 11) BEGIN SPRINT effdesc ~%effdesc%~^~免疫非寒铁武器~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN

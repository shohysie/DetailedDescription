	PATCH_IF opcode == 106 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~士气崩溃阈值修正：%readamount%（越低越容易崩溃）~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN

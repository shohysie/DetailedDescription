		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~传送回已记忆地点~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~交换源和目标~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN

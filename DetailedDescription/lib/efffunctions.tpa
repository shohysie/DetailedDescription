	PATCH_IF opcode == 134 BEGIN
		SPRINT effdesc ~%effdesc%~^~石化~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 135 BEGIN
		PATCH_IF (STRING_LENGTH ~%readres%~ == 0) BEGIN
			PATCH_IF (readtype == "-1") BEGIN SPRINT effdesc ~%effdesc%~^~解除所有变形~ SET descfixed = 1 END
			PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~解除数值和外形均改变的变形~ SET descfixed = 1 END
			PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~解除仅外形改变的变形~ SET descfixed = 1 END
		END ELSE BEGIN
			PATCH_IF FILE_EXISTS_IN_GAME ~%readres%.cre~ BEGIN
				LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR crecode = EVAL ~%readres%~ RET namestr END
				PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~变形为：%namestr%（数值和外形均改变）~ SET descfixed = 1 END
				PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~变形为：%namestr%（仅外形改变）~ SET descfixed = 1 END
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF location == 2 THEN BEGIN
				PATCH_IF readpara3 > 0 THEN BEGIN SPRINT effdesc ~%effdesc%~^~，动画圆圈半径：%readpara3%~ END
				PATCH_IF readpara4 > 0 THEN BEGIN
					LOOKUP_IDS_SYMBOL_OF_INT idsentry ~ANIMATE~ readpara4
					SPRINT effdesc ~%effdesc%~^~，动画设为：%idsentry%~
				END
			END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 136 BEGIN
		SPRINT effdesc ~%effdesc%~^~强制可见~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END

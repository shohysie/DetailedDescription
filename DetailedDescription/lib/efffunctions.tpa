/* **************************************** */

//读取地址与众不同的opcode：
//12 129 130-133, 137 233 234 319
//调用 CHECK_ATTACH_EFFECT 解析额外效果的opcode：
//opcode 177, 283; 183, 248, 249, 272
//注意：177, 283调用的eff文件不需要读取持续时间，仅调用该eff的效果需要

//给出法术/物品在使用/装备时可能产生的具体效果

DEFINE_PATCH_FUNCTION CHECK_ITM_SPL_EFF_EFFECT
INT_VAR
	detailed = 1	//为0不进行详细说明；为1详细说明；为2详细说明但调用SCRAMBLED_TEXT_NAMECHECK时showname=detailed传递极简说明需求；
					//为3表示被SCRAMBLED_TEXT_NAMECHECK调用，真正进行极简说明，但之后调用SCRAMBLED_TEXT_NAMECHECK只能showname=0
	location = 0	//0法术效果或物品头部效果 1装备时的效果 2被使用的eff文件
	viaopcode = 0	//作为eff文件时是被哪个opcode调用，如果是177/283则eff文件不需要读取持续时间
	firsteff = 0	//从第几个效果开始数。法术和物品的所有效果其实都是平铺，每个0x30。这个参数方便循环读取spl/itm多个头部的各个效果
	effectnum = 1	//从firsteff数起第几个eff，第一个就是firsteff
RET
	effdesc
BEGIN
	//如果是对法术或物品进行描述，开头“回车－”；如果是对eff文件进行描述，开头结尾用{}包裹
	PATCH_IF location != 2 BEGIN
		SPRINT effdesc ~%WNL%－~
		READ_LONG 0x6a effoffset	//无论物品文件还是法术文件，效果的起始地址都在这里
		READ_SHORT (effoffset + 0x30 * (firsteff + effectnum - 1)) opcode
		READ_LONG (4 + effoffset + 0x30 * (firsteff + effectnum - 1)) readamount
		READ_LONG (8 + effoffset + 0x30 * (firsteff + effectnum - 1)) readtype
		READ_ASCII (20 + effoffset + 0x30 * (firsteff + effectnum - 1)) readres
		READ_LONG (28 + effoffset + 0x30 * (firsteff + effectnum - 1)) readdicethrown
		READ_LONG (32 + effoffset + 0x30 * (firsteff + effectnum - 1)) readdicesides
		READ_LONG (44 + effoffset + 0x30 * (firsteff + effectnum - 1)) readspecial
	END ELSE BEGIN
		SPRINT effdesc ~(%SOURCE_FILE%){~
		READ_LONG 0x10 opcode
		READ_LONG 0x1c readamount
		READ_LONG 0x20 readtype
		READ_ASCII 0x30 readres
		READ_LONG 0x38 readdicethrown
		READ_LONG 0x3c readdicesides
		READ_LONG 0x48 readspecial
		READ_LONG 0x60 readpara3
		READ_LONG 0x64 readpara4
		READ_LONG 0x68 readpara5
		READ_ASCII 0x70 readres2
		READ_ASCII 0x78 readres3
	END

//PATCH_PRINT ~patch对象: %SOURCE_FILE%，opcode=%opcode%~

	PATCH_IF detailed == 0 BEGIN	//如果不追求详细描述，有些效果就不处理了
		PATCH_IF ((opcode == 142)||(opcode == 169)||(opcode == 240)||(opcode == 265)||(opcode == 309)||(opcode == 318)||(opcode == 321)||(opcode == 324)||(opcode == 326)||(opcode == 328)) BEGIN
			SET opcode = 9999
		END
	END	
	PATCH_IF detailed > 2 BEGIN	//最详细描述，图标相关不处理
		PATCH_IF ((opcode == 142)||(opcode == 169)||(opcode == 240)) BEGIN
			SET opcode = 9999
		END
	END
	SET descfixed = 0

	PATCH_IF opcode == 0 BEGIN
		PATCH_IF (readtype == 16) BEGIN SPRINT effdesc ~%effdesc%~^~防御等级设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 8) BEGIN SPRINT effdesc ~%effdesc%~^~挥砍防御修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~穿刺防御修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程防御修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~钝击防御修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~防御等级修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 1 BEGIN
		PATCH_IF readamount > 5 BEGIN
			SET readamount = (readamount * 2 - 11)
			PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数修正：%readamount%／2~ SET descfixed = 1 END
			PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数设为：%readamount%／2~ SET descfixed = 1 END
			PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数最终设为：%readamount%／2~ SET descfixed = 1 END
		END ELSE BEGIN
			PATCH_IF readamount < "-5" BEGIN
				SET readamount = (readamount * 2 + 11)
				PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数修正：-%readamount%／2~ SET descfixed = 1 END
			END ELSE BEGIN
				PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数修正：%readamount%~ SET descfixed = 1 END
				PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数设为：%readamount%~ SET descfixed = 1 END
				PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数设为当前的%readamount%％~ SET descfixed = 1 END
				PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~每轮攻击次数最终设为：%readamount%~ SET descfixed = 1 END
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 2 BEGIN
		SPRINT effdesc ~%effdesc%~^~解除昏迷~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 3 BEGIN
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~I型狂暴~ SET descfixed = 1 END
		ELSE BEGIN SPRINT effdesc ~%effdesc%~^~战斗中狂暴~ SET descfixed = 1 END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 4 BEGIN
		SPRINT effdesc ~%effdesc%~^~解除I型狂暴~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 5 BEGIN
		PATCH_IF (readamount == 0) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：全部~ SET descfixed = 1 END
		PATCH_IF (readamount == 1) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：人类~ SET descfixed = 1 END
		PATCH_IF (readamount == 2) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：动物~ SET descfixed = 1 END
		PATCH_IF (readamount == 4) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：不死生物~ SET descfixed = 1 END
		PATCH_IF (readamount == 5) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：巨人~ SET descfixed = 1 END
		PATCH_IF (readamount == 7) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：植物~ SET descfixed = 1 END
		PATCH_IF (readamount == 255) BEGIN SPRINT effdesc ~%effdesc%~^~魅惑生物类型：怪物~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 6 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~魅力修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~魅力设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~魅力设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 10 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~体质修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~体质设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~体质设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 11 BEGIN
		SPRINT effdesc ~%effdesc%~^~解除中毒~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 12 BEGIN
		SET readtype1 = readtype BAND 0xffff
		SET readtype2 = readtype BLSR 16
		SET readspecial1 = readspecial BAND 0xffff
		SET readspecial2 = readspecial BLSR 16
		PATCH_IF (readtype2 == 0) BEGIN SPRINT effdesc ~%effdesc%~^~钝击伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 1) BEGIN SPRINT effdesc ~%effdesc%~^~强酸伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 2) BEGIN SPRINT effdesc ~%effdesc%~^~寒冷伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 4) BEGIN SPRINT effdesc ~%effdesc%~^~电击伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 8) BEGIN SPRINT effdesc ~%effdesc%~^~火焰伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 16) BEGIN SPRINT effdesc ~%effdesc%~^~穿刺伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 32) BEGIN SPRINT effdesc ~%effdesc%~^~毒素伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 64) BEGIN SPRINT effdesc ~%effdesc%~^~魔法伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 128) BEGIN SPRINT effdesc ~%effdesc%~^~远程伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 256) BEGIN SPRINT effdesc ~%effdesc%~^~挥砍伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 512) BEGIN SPRINT effdesc ~%effdesc%~^~魔法火焰伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 1024) BEGIN SPRINT effdesc ~%effdesc%~^~魔法寒冷伤害~ SET descfixed = 1 END
		PATCH_IF (readtype2 == 2048) BEGIN SPRINT effdesc ~%effdesc%~^~瘀伤~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF (readtype1 == 0) BEGIN SPRINT effdesc ~%effdesc%~^~：~ SET descfixed = 2 END
			PATCH_IF (readtype1 == 1) BEGIN SPRINT effdesc ~%effdesc%~^~（HP设为）：~ SET descfixed = 2 END
			PATCH_IF (readtype1 == 2) BEGIN SPRINT effdesc ~%effdesc%~^~（HP设为百分比）：~ SET descfixed = 2 END
			PATCH_IF (readtype1 == 3) BEGIN SPRINT effdesc ~%effdesc%~^~（HP失去百分比）：~ SET descfixed = 2 END
		END
		PATCH_IF (descfixed == 2) BEGIN
			PATCH_IF (readdicethrown != 0) && (readdicesides != 0) BEGIN
				SPRINT effdesc ~%effdesc%~^~%readdicethrown%D%readdicesides%~
				PATCH_IF readamount > 0 BEGIN SPRINT effdesc ~%effdesc%~^~＋%readamount%~ END
				PATCH_IF readamount < 0 BEGIN SPRINT effdesc ~%effdesc%~^~%readamount%~ END
			END
			PATCH_IF (readdicethrown == 0)||(readdicesides == 0) BEGIN SPRINT effdesc ~%effdesc%~^~%readamount%~ END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			PATCH_IF (readspecial1 & 0b00000001) = 0b00000001 BEGIN SPRINT effdesc ~%effdesc%~^~，吸血~ END
			PATCH_IF (readspecial1 & 0b00000010) = 0b00000010 BEGIN SPRINT effdesc ~%effdesc%~^~，反向吸血~ END
			PATCH_IF (readspecial1 & 0b00000100) = 0b00000100 BEGIN SPRINT effdesc ~%effdesc%~^~，瘀伤（需使用拳头）~ END
			PATCH_IF (readspecial1 & 0b00001000) = 0b00001000 BEGIN SPRINT effdesc ~%effdesc%~^~，吸血（不累加）~ END
			PATCH_IF (readspecial1 & 0b00010000) = 0b00010000 BEGIN SPRINT effdesc ~%effdesc%~^~，反向吸血（不累加）~ END
			PATCH_IF (readspecial2 & 0b00000001) = 0b00000001 BEGIN SPRINT effdesc ~%effdesc%~^~，通过豁免伤害减半~ END
			PATCH_IF (readspecial1 & 0b00000010) = 0b00000010 BEGIN SPRINT effdesc ~%effdesc%~^~，未过豁免伤害减半~ END
			PATCH_IF (readspecial1 & 0b00000100) = 0b00000100 BEGIN SPRINT effdesc ~%effdesc%~^~，不会打醒睡眠生物~ END
		END ELSE BEGIN
			SET descfixed = 0	//描述不完全=完全不描述
		END
	END
	PATCH_IF opcode == 13 BEGIN
		SPRINT effdesc ~%effdesc%~^~即死~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 14 BEGIN
		SPRINT effdesc ~%effdesc%~^~解除冰冻~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 15 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~敏捷修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~敏捷设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~敏捷设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~猫之优雅~ SET descfixed = 1
			PATCH_IF (location == 2)&&((viaopcode == 177)||(viaopcode == 283)) THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~敏捷修正：%readamount%~
			END	
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF (opcode == 16)||(opcode == 317) BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~加速~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~高等加速~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~加速但不加攻击次数~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			PATCH_IF (opcode == 317) BEGIN SPRINT effdesc ~%effdesc%~^~，武僧可用~ END
		END
	END

	PATCH_IF opcode == 17 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~HP修正：~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~HP设为：~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~HP设为当前的百分比：~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF (readdicethrown != 0) && (readdicesides != 0) BEGIN
				SPRINT effdesc ~%effdesc%~^~%readdicethrown%D%readdicesides%~
				PATCH_IF readamount > 0 BEGIN SPRINT effdesc ~%effdesc%~^~＋%readamount%~ END
				PATCH_IF readamount < 0 BEGIN SPRINT effdesc ~%effdesc%~^~%readamount%~ END
			END
			PATCH_IF (readdicethrown == 0)||(readdicesides == 0) BEGIN SPRINT effdesc ~%effdesc%~^~%readamount%~ END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 18 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP修正（当前HP随之变化）：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP设为（当前HP随之变化）：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP设为（当前HP随之变化）：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP修正（当前HP不变）：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP设为（当前HP不变）：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP设为（当前HP不变）：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (readtype == 6) BEGIN SPRINT effdesc ~%effdesc%~^~最大HP修正（当前HP随之变化）：%readamount%（不累加）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 19 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~智力修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~智力设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~智力设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 20 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~隐形~ SET descfixed = 1 
			PATCH_IF (location == 2)&&(viaopcode == 183) THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~且不因为敌对行为而解除~
			END
		END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~高等隐形~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~半隐形~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 21 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~学识修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~学识设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~学识设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 22 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~幸运（可累加）修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~幸运（可累加）设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~幸运（可累加）设为当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 23 BEGIN
		PATCH_IF (readspecial == 0) BEGIN SPRINT effdesc ~%effdesc%~^~非狂暴状态下，士气设为10~ SET descfixed = 1 END
		PATCH_IF (readspecial == 1) BEGIN 
			PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~士气修正：%readamount%~ SET descfixed = 1 END
			PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~士气设为：%readamount%~ SET descfixed = 1 END
			PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~士气设为现有的%readamount%％~ SET descfixed = 1 END
		END
		PATCH_IF (descfixed == 1) BEGIN
			//SPRINT effdesc ~%effdesc%~^~（生物具有“初始士气”“士气崩溃阈值”和“士气恢复间隔”三个数据。队友死亡-2士气[限玩家]，HP每次低于50%和25%时-2士气，每经过“士气恢复间隔”帧恢复1点士气）。当士气低于“士气崩溃阈值”时陷入恐惧或狂暴）~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 24 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~恐惧~ SET descfixed = 1 END
		ELSE BEGIN SPRINT effdesc ~%effdesc%~^~恐惧（无视免疫）~ SET descfixed = 1 END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 25 BEGIN
		PATCH_IF location == 2 THEN BEGIN SET readpara3 = (readpara3 == 0)? 1 : readpara3 END ELSE BEGIN SET readpara3 = 1 END
		PATCH_IF location == 2 THEN BEGIN SET readpara4 = (readpara4 == 0)? 1 : readpara4 END ELSE BEGIN SET readpara4 = 1 END
		PATCH_IF (readamount != 0)&&(readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~中毒（每秒1点毒素伤害）~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN
			PATCH_IF (readpara4 != 0) BEGIN
				SPRINT effdesc ~%effdesc%~^~中毒（每秒1点毒素伤害）~ SET descfixed = 1
			END ELSE BEGIN
				PATCH_IF (readamount < 100) BEGIN
					SPRINT effdesc ~%effdesc%~^~中毒（每秒1点毒素伤害）~ SET descfixed = 1
				END
				PATCH_IF (readamount > 99)&&(readamount < 256) BEGIN
					SPRINT effdesc ~%effdesc%~^~中毒（生物HP>100／%readamount%时每秒1点毒素伤害）~ SET descfixed = 1
				END
			END
		END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~中毒（每%readpara4%秒%readamount%点毒素伤害）~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~中毒（每%readpara4%×%readamount%秒1点毒素伤害）~ SET descfixed = 1 END
		PATCH_IF (readtype == 4)&&(location == 2) BEGIN SPRINT effdesc ~%effdesc%~^~中毒（每%readpara4%×%readamount%秒%readpara3%点毒素伤害）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN

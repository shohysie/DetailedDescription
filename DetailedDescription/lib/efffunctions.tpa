		PATCH_IF (readtype == 12) BEGIN SPRINT effdesc ~%effdesc%~^~禁止快捷物品III按钮~ SET descfixed = 1 END
		PATCH_IF (readtype == 13) BEGIN SPRINT effdesc ~%effdesc%~^~禁止施展特殊能力按钮~ SET descfixed = 1 END
		PATCH_IF (readtype == 14) BEGIN SPRINT effdesc ~%effdesc%~^~禁止寻找陷阱按钮~ SET descfixed = 1 END
		PATCH_IF (readtype == 15) BEGIN SPRINT effdesc ~%effdesc%~^~禁止物品栏按钮~ SET descfixed = 1 END

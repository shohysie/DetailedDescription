		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~昏迷（不会被打醒）~ SET descfixed = 1 END
		PATCH_IF (readspecial > 0)&&(readspecial != 14) THEN BEGIN
			INNER_ACTION BEGIN
				COPY_EXISTING ~STATDESC.2DA~ ~override~
					COUNT_2DA_ROWS 3 maxrows
					FOR ( index = 1 ; index < maxrows ; index = index + 1 ) BEGIN
						READ_2DA_ENTRY index 0 3 readiconcode
						READ_2DA_ENTRY index 1 3 readicondesc
						PATCH_IF readiconcode == readspecial THEN BEGIN
							PATCH_IF readicondesc > 0 THEN BEGIN
								GET_STRREF readicondesc tempdesc
								SPRINT effdesc ~%effdesc%~^~（显示图标：%tempdesc%）~
								SET index = maxrows + 1
							END
						END
					END
				BUT_ONLY
			END		
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

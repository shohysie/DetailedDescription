		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~近战伤害修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~近战伤害设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~近战伤害设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 286 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT effdesc ~%effdesc%~^~远程伤害修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~远程伤害设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~远程伤害设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END

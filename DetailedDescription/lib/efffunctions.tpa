		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：破魔~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：破幻~ SET descfixed = 1 END
		PATCH_IF (readtype == 6) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：咒法~ SET descfixed = 1 END
		PATCH_IF (readtype == 7) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：战斗防护~ SET descfixed = 1 END
		PATCH_IF (readtype == 8) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：意外~ SET descfixed = 1 END
		PATCH_IF (readtype == 9) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：战场~ SET descfixed = 1 END
		PATCH_IF (readtype == 10) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：攻击伤害~ SET descfixed = 1 END
		PATCH_IF (readtype == 11) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：失能~ SET descfixed = 1 END
		PATCH_IF (readtype == 12) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：综合~ SET descfixed = 1 END
		PATCH_IF (readtype == 13) BEGIN SPRINT effdesc ~%effdesc%~^~反弹第二类型：非战斗~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF readamount > 0  BEGIN SPRINT effdesc ~%effdesc%~^~，总共反弹%readamount%次~ SET descfixed = 1 END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 229 BEGIN
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个防护系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个咒法系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个预言系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个附魔系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个幻术系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 6) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个塑能系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 7) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个死灵系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 8) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个变化系法术的效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 9) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个任意学派法术的效果~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF readamount > 0  BEGIN SPRINT effdesc ~%effdesc%~^~，最高法术等级%readamount%~ SET descfixed = 1 END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 230 BEGIN
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为法术防护的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为特殊防护的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为幻术防护的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为破魔的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 5) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为破幻的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 6) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为咒法的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 7) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为战斗防护的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 8) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为意外的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 9) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为战场的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 10) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为攻击伤害的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 11) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为失能的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 12) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为综合的法术效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 13) BEGIN SPRINT effdesc ~%effdesc%~^~移除一个第二类型为非战斗的法术效果~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF readamount > 0  BEGIN SPRINT effdesc ~%effdesc%~^~，最高法术等级%readamount%~ SET descfixed = 1 END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 231 BEGIN
		SPRINT effdesc ~%effdesc%~^~时间停止~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 232 BEGIN
		PATCH_MATCH readtype
		WITH
			0 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：被攻击命中~ SET descfixed = 1 END
			1 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：发现敌人~ SET descfixed = 1 END
			2 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：HP小于50％~ SET descfixed = 1 END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：HP小于25％~ SET descfixed = 1 END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：HP小于10％~ SET descfixed = 1 END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：处于无助状态~ SET descfixed = 1 END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：中毒~ SET descfixed = 1 END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：遭受攻击~ SET descfixed = 1 END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：4呎内存在生物~ SET descfixed = 1 END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：10呎内存在生物~ SET descfixed = 1 END
			11 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：受伤~ SET descfixed = 1 END
			12 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：杀死生物~ SET descfixed = 1 END
			13 BEGIN PATCH_IF readamount == 0 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：处于时间段：~ SET descfixed = 1 END END
			14 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：%readspecial%呎内存在生物~ SET descfixed = 1 END
			15 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：有生物（含自身）处于~ SET descfixed = 1 END
			16 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：自身死亡~ SET descfixed = 1 END
			17 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：有生物（含自身）死亡~ SET descfixed = 1 END
			18 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：被超度~ SET descfixed = 1 END
			19 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：HP小于%readspecial%~ SET descfixed = 1 END
			20 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：HP小于%readspecial%％~ SET descfixed = 1 END
			21 BEGIN SPRINT effdesc ~%effdesc%~^~符合条件施法：处于~ SET descfixed = 1 END
			DEFAULT SET descfixed = 0
		END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF (readtype == 13) BEGIN
				PATCH_MATCH readspecial
					WITH
					0 BEGIN SPRINT effdesc ~%effdesc%~^~白天~ END
					1 BEGIN SPRINT effdesc ~%effdesc%~^~黄昏~ END
					2 BEGIN SPRINT effdesc ~%effdesc%~^~夜晚~ END
					3 BEGIN SPRINT effdesc ~%effdesc%~^~早晨~ END
					DEFAULT SPRINT effdesc ~%effdesc%~^~（时间出错）~
				END
			END
			PATCH_IF readtype == 15 BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~state~ readspecial
				SPRINT effdesc ~%effdesc%~^~%idsentry%状态~
			END
			PATCH_IF readtype == 21 BEGIN
				LOOKUP_IDS_SYMBOL_OF_INT idsentry ~splstate~ readspecial
				SPRINT effdesc ~%effdesc%~^~%idsentry%状态~
			END
			PATCH_MATCH readamount
				WITH
				0 BEGIN SPRINT effdesc ~%effdesc%~^~时，对自身施法：~ END
				1 BEGIN SPRINT effdesc ~%effdesc%~^~时，对最后攻击者施法：~ END
				2 BEGIN SPRINT effdesc ~%effdesc%~^~时，对最近的敌人施法：~ END
				DEFAULT SPRINT effdesc ~%effdesc%~^~时，对最近的生物施法：~
			END
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR splcode = EVAL ~%readres%~ RET namestr END
			SPRINT effdesc ~%effdesc%~^~%namestr%~
			PATCH_IF location == 2 THEN BEGIN
				PATCH_IF STRING_LENGTH ~%readres2%~ > 0 THEN BEGIN 
					LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres2%~ RET namestr END
					SPRINT effdesc ~%effdesc%~^~、%namestr%~
				END
				PATCH_IF STRING_LENGTH ~%readres3%~ > 0 THEN BEGIN 
					LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres3%~ RET namestr END
					SPRINT effdesc ~%effdesc%~^~、%namestr%~
				END
				PATCH_IF readpara3 == 1 THEN BEGIN SPRINT effdesc ~%effdesc%~^~，如同意外术~ END
			END
			PATCH_IF (readspecial & 0b00000001) = 0b00000001 THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~(仅触发一次)~
			END
			PATCH_IF (readspecial & 0b00000010) = 0b00000010 THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~(法术由原施法者向检查此条件的生物施展)~
			END
			PATCH_IF (readspecial & 0b00000100) = 0b00000100 THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~(不显示施法光球和文字提示)~
			END
			PATCH_IF (readspecial & 0b00001000) = 0b00001000 THEN BEGIN
				SPRINT effdesc ~%effdesc%~^~(忽略法术距离限制)~
			END
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 233 BEGIN
		SET readamount1 = readamount / 8	//original class
		SET readamount = readamount MODULO 8	//active class
		SET readmode = readtype BLSR 16
		SET readtype = readtype BAND 0xffff
		PATCH_IF !VARIABLE_IS_SET $wprof_namestring("%readtype%") BEGIN
			INNER_ACTION BEGIN
				COPY_EXISTING ~WEAPPROF.2DA~ ~override~
					COUNT_2DA_ROWS 12 rows
					FOR ( index = 1 ; index < rows ; index = index + 1 ) BEGIN
						READ_2DA_ENTRY index 1 12 wprof_id
						PATCH_IF wprof_id < 116 BEGIN
							READ_2DA_ENTRY index 2 12 wprof_name
							PATCH_IF (wprof_name > 0 && wprof_name < 2147483646) BEGIN
								GET_STRREF wprof_name wprof_string
								PATCH_IF (~%wprof_string%~ STRING_CONTAINS_REGEXP ~Invalid Strref~)&&(STRING_LENGTH ~%wprof_string%~ != 0) BEGIN
									SPRINT $wprof_namestring(~%wprof_id%~) ~%wprof_string%~
								END
							END
						END
					END
				BUT_ONLY
			END
		END
		PATCH_IF (VARIABLE_IS_SET $wprof_namestring("%readtype%") && (readmode == 0 || readmode == 1) && (readamount1 >= 0)) BEGIN
			SPRINT temp_string $wprof_namestring(~%readtype%~)
			SET descfixed = 1
		END
		PATCH_IF (descfixed == 1) BEGIN
			PATCH_IF (readamount1 > 0) BEGIN	//有旧职业
				PATCH_IF (readmode == 0) BEGIN
					SPRINT effdesc ~%effdesc%~^~设置旧职业%temp_string%熟练度为%readamount%星，新职业%temp_string%熟练度为%readamount1%星~
				END ELSE BEGIN
					SPRINT effdesc ~%effdesc%~^~提升旧职业%temp_string%熟练度%readamount%星，新职业%temp_string%熟练度%readamount1%星~
				END
			END ELSE BEGIN	//readamount1 = 0只有当前职业
				PATCH_IF (readmode == 0) BEGIN
					SPRINT effdesc ~%effdesc%~^~设置%temp_string%熟练度为%readamount%星~
				END ELSE BEGIN
					SPRINT effdesc ~%effdesc%~^~提升%temp_string%熟练度%readamount%星~
				END
			END
		END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 234 BEGIN
		SET readmode = readtype BLSR 16
		SET readtype = readtype BAND 0xffff
		PATCH_IF (readmode == 0) BEGIN SPRINT effdesc ~%effdesc%~^~连锁意外术~ SET descfixed = 1 END
		PATCH_IF (readmode == 1) BEGIN SPRINT effdesc ~%effdesc%~^~普通意外术~ SET descfixed = 1 END
		PATCH_IF (readmode == 2) BEGIN SPRINT effdesc ~%effdesc%~^~序列器~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			SET readtype = (readtype > 3) ? 3 : readtype
			SPRINT effdesc ~%effdesc%~^~，最高可装填%readamount%级法术，数量为%readtype%~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 235 BEGIN
		PATCH_IF (readtype == 0)||(readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~吹飞，速度%readamount%远离发生地~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~吹飞，速度%readamount%远离使用者~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~吹飞，速度%readamount%朝向发生地~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT effdesc ~%effdesc%~^~吹飞，速度%readamount%朝向使用者~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END
	PATCH_IF opcode == 236 BEGIN
		PATCH_IF (readtype == 0)||(readtype > 3) BEGIN SPRINT effdesc ~%effdesc%~^~复制~ SET descfixed = 1 END
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~误导~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~投影~ SET descfixed = 1 END
		PATCH_IF (readtype == 3) BEGIN SPRINT effdesc ~%effdesc%~^~拟像~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 238 BEGIN
		SPRINT effdesc ~%effdesc%~^~解离生物类型：~ SET descfixed = 1
		PATCH_MATCH readtype
		WITH
			2 BEGIN SPRINT effdesc ~%effdesc%~^~（敌友类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~EA~ readamount END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~（一般类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~General~ readamount END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~（种族类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Race~ readamount END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~（职业类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Class~ readamount END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~（特殊类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Specific~ readamount END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~（性别类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Gender~ readamount END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~（阵营类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Align~ readamount END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~（宗派类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Kit~ readamount END
			DEFAULT SPRINT effdesc ~%effdesc%~^~（错误的类型代码）~ SPRINT idsentry ~~
		END
		SPRINT effdesc ~%effdesc%~^~%idsentry%~
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 239 BEGIN
		SPRINT effdesc ~%effdesc%~^~远视术~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 240 BEGIN
		INNER_ACTION BEGIN
			COPY_EXISTING ~STATDESC.2DA~ ~override~
				COUNT_2DA_ROWS 3 maxrows
				FOR ( index = 1 ; index < maxrows ; index = index + 1 ) BEGIN
					READ_2DA_ENTRY index 0 3 readiconcode
					READ_2DA_ENTRY index 1 3 readicondesc
					PATCH_IF readiconcode == readtype THEN BEGIN
						PATCH_IF readicondesc > 0 THEN BEGIN
							GET_STRREF readicondesc tempdesc
							SPRINT effdesc ~%effdesc%~^~移除图标：%tempdesc%~ SET descfixed = 1
							SET index = maxrows + 1
						END
					END
				END
			BUT_ONLY
		END
		PATCH_IF descfixed == 1 THEN BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 241 BEGIN
		PATCH_IF (readamount == 0) BEGIN SPRINT effdesc ~%effdesc%~^~控制生物类型：全部~ SET descfixed = 1 END
		PATCH_IF (readamount == 1) BEGIN SPRINT effdesc ~%effdesc%~^~控制生物类型：人类~ SET descfixed = 1 END
		PATCH_IF (readamount == 2) BEGIN SPRINT effdesc ~%effdesc%~^~控制生物类型：动物~ SET descfixed = 1 END
		PATCH_IF (readamount == 4) BEGIN SPRINT effdesc ~%effdesc%~^~控制生物类型：不死生物~ SET descfixed = 1 END
		PATCH_IF (readamount == 5) BEGIN SPRINT effdesc ~%effdesc%~^~控制生物类型：巨人~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 242 BEGIN
		SPRINT effdesc ~%effdesc%~^~解除困惑~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 243 BEGIN
		SPRINT effdesc ~%effdesc%~^~吸取%readamount%个物品使用次数~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 244 BEGIN
		SPRINT effdesc ~%effdesc%~^~吸取%readamount%个法师法术~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 245 BEGIN
		SPRINT effdesc ~%effdesc%~^~1％概率陷入狂暴~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 246 BEGIN
		SPRINT effdesc ~%effdesc%~^~I型狂暴~ SET descfixed = 1
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 247 BEGIN
		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~II型狂暴~ SET descfixed = 1 END
		ELSE BEGIN SPRINT effdesc ~%effdesc%~^~战斗中II型狂暴~ SET descfixed = 1 END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	
	PATCH_IF opcode == 248 BEGIN
		PATCH_IF (readtype == 0) BEGIN SPRINT tempdesc ~%effdesc%~^~设置近战攻击触发特定效果~ SET descfixed = 1 END
		PATCH_IF (readtype == 4) BEGIN SPRINT tempdesc ~%effdesc%~^~设置徒手攻击触发特定效果~ SET descfixed = 1 END

		END
	END
	PATCH_IF opcode == 122 BEGIN
		PATCH_IF location != 2 THEN BEGIN
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr END
			PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN
				SPRINT effdesc ~%effdesc%~^~创建物品栏物品：%namestr%，数量%readamount%~ SET descfixed = 1
				LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			END
		END ELSE BEGIN
				LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr0 = namestr END
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres2%~ RET namestr1 = namestr END
			LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres3%~ RET namestr2 = namestr END
			PATCH_IF ((~%namestr0%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr0%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN SET descfixed = 1 END
			PATCH_IF ((~%namestr1%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr1%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN SET descfixed = 2 END
			PATCH_IF ((~%namestr2%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr2%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN SET descfixed = 3 END
			PATCH_IF (descfixed == 1) BEGIN
				SPRINT effdesc ~%effdesc%~^~创建物品栏物品：%namestr0%，数量%readamount%~
				PATCH_IF (readpara3 > 0)||(readpara4 > 0) BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara3%~ END
				PATCH_IF readpara4 > 0 BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara4%~ END
				LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			END
			PATCH_IF (descfixed == 2) BEGIN
				SPRINT effdesc ~%effdesc%~^~创建物品栏物品：%namestr0%／%namestr1%，数量%readamount%~
				PATCH_IF (readpara3 > 0)||(readpara4 > 0) BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara3%~ END
				PATCH_IF readpara4 > 0 BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara4%~ END
				LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			END
			PATCH_IF (descfixed == 3) BEGIN
				PATCH_IF (FILE_EXISTS_IN_GAME ~%readres2%.itm~) BEGIN
					SPRINT effdesc ~%effdesc%~^~创建物品栏物品：%namestr0%／%namestr1%／%namestr2%，数量%readamount%~
				END ELSE BEGIN
					SPRINT effdesc ~%effdesc%~^~创建物品栏物品：%namestr0%／%namestr2%，数量%readamount%~
				END
				PATCH_IF (readpara3 > 0)||(readpara4 > 0) BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara3%~ END
				PATCH_IF readpara4 > 0 BEGIN SPRINT effdesc ~%effdesc%~^~／%readpara4%~ END
				LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
			END
		END
	END
	PATCH_IF opcode == 123 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN

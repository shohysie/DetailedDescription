		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~金币数设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~金币数设为现有的%readamount%％~ SET descfixed = 1 END

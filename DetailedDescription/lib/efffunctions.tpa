	PATCH_IF opcode == 138 BEGIN
		SPRINT effdesc ~%effdesc%~^~演示动作：~ SET descfixed = 1
		PATCH_MATCH readtype
		WITH
			0 BEGIN SPRINT effdesc ~%effdesc%~^~攻击~ END
			1 BEGIN SPRINT effdesc ~%effdesc%~^~苏醒~ END
			2 BEGIN SPRINT effdesc ~%effdesc%~^~施法~ END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~召唤~ END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~受伤~ END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~死亡~ END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~超度~ END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~准备~ END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~射击~ END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~抽搐~ END
			10 BEGIN SPRINT effdesc ~%effdesc%~^~行走~ END
			11 BEGIN SPRINT effdesc ~%effdesc%~^~攻击（竖劈）~ END
			12 BEGIN SPRINT effdesc ~%effdesc%~^~攻击（横扫）~ END
			13 BEGIN SPRINT effdesc ~%effdesc%~^~攻击（直刺）~ END
			14 BEGIN SPRINT effdesc ~%effdesc%~^~显形~ END
			15 BEGIN SPRINT effdesc ~%effdesc%~^~隐藏~ END
			16 BEGIN SPRINT effdesc ~%effdesc%~^~昏睡~ END
			DEFAULT SPRINT effdesc ~%effdesc%~^~错误的动作代码~
		END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END

	PATCH_IF opcode == 142 BEGIN
		INNER_ACTION BEGIN
			COPY_EXISTING ~STATDESC.2DA~ ~override~
				COUNT_2DA_ROWS 3 maxrows
				FOR ( index = 1 ; index < maxrows ; index = index + 1 ) BEGIN
					READ_2DA_ENTRY index 0 3 readiconcode
					READ_2DA_ENTRY index 1 3 readicondesc
					PATCH_IF readiconcode == readtype THEN BEGIN
						PATCH_IF readicondesc > 0 THEN BEGIN
							GET_STRREF readicondesc tempdesc
							SPRINT effdesc ~%effdesc%~^~显示图标：%tempdesc%~ SET descfixed = 1
							SET index = maxrows + 1
						END
					END
				END
			BUT_ONLY
		END
		PATCH_IF descfixed == 1 THEN BEGIN
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 143 BEGIN
		LOOKUP_IDS_SYMBOL_OF_INT idsentry ~SLOTS~ readamount
		PATCH_IF (readamount == 15) BEGIN SPRINT idsentry ~SLOT_MISC0（QUICK0）~ END
		PATCH_IF (readamount == 16) BEGIN SPRINT idsentry ~SLOT_MISC1（QUICK1）~ END
		PATCH_IF (readamount == 17) BEGIN SPRINT idsentry ~SLOT_MISC2（QUICK2）~ END
		PATCH_IF (readamount == 34) BEGIN SPRINT idsentry ~SLOT_MISC19（Magical_Weapon）~ END

		PATCH_IF (readtype == 1) BEGIN SPRINT effdesc ~%effdesc%~^~徒手伤害设为：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~徒手伤害设为：当前的%readamount%％~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN

	PATCH_IF (opcode == 119)||(opcode == 159) BEGIN
		PATCH_IF (opcode == 119) BEGIN SPRINT effdesc ~%effdesc%~^~产生镜影~ SET descfixed = 1 END
		ELSE BEGIN SPRINT effdesc ~%effdesc%~^~产生%readamount%个镜影~ SET descfixed = 1 END
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END

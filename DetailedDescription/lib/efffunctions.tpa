		PATCH_IF (readtype & 0b0000000000000010) = 0b0000000000000010 BEGIN SPRINT effdesc ~%effdesc%~^~牧师2级法术记忆数量修正：%readamount%~ SET descfixed = 1 END
		PATCH_IF (readtype & 0b0000000000000100) = 0b0000000000000100 BEGIN SPRINT effdesc ~%effdesc%~^~牧师3级法术记忆数量修正：%readamount%~ SET descfixed = 1 END

			ELSE BEGIN SPRINT effdesc ~%effdesc%~^~士气崩溃阈值设为%readamount%（越低越容易崩溃）~ SET descfixed = 1 END
		END			PATCH_IF (readtype == 2) BEGIN SPRINT effdesc ~%effdesc%~^~士气崩溃阈值设为现有的%readamount%％（越低越容易崩溃）~ SET descfixed = 1 END
		PATCH_IF (descfixed == 1) BEGIN
			//SPRINT effdesc ~%effdesc%~^~（生物具有“初始士气”“士气崩溃阈值”和“士气恢复间隔”三个数据。队友死亡-2士气[限玩家]，HP每次低于50%和25%时-2士气，每经过“士气恢复间隔”帧恢复1点士气）。当士气低于“士气崩溃阈值”时陷入恐惧或狂暴）~
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
	END

	PATCH_IF opcode == 109 BEGIN
		SPRINT effdesc ~%effdesc%~^~麻痹生物类型：~ SET descfixed = 1
		PATCH_MATCH readtype
		WITH
			2 BEGIN SPRINT effdesc ~%effdesc%~^~（敌友类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~EA~ readamount END
			3 BEGIN SPRINT effdesc ~%effdesc%~^~（一般类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~General~ readamount END
			4 BEGIN SPRINT effdesc ~%effdesc%~^~（种族类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Race~ readamount END
			5 BEGIN SPRINT effdesc ~%effdesc%~^~（职业类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Class~ readamount END
			6 BEGIN SPRINT effdesc ~%effdesc%~^~（特殊类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Specific~ readamount END
			7 BEGIN SPRINT effdesc ~%effdesc%~^~（性别类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Gender~ readamount END
			8 BEGIN SPRINT effdesc ~%effdesc%~^~（阵营类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Align~ readamount END
			9 BEGIN SPRINT effdesc ~%effdesc%~^~（宗派类型）~ LOOKUP_IDS_SYMBOL_OF_INT idsentry ~Kit~ readamount END
			DEFAULT SPRINT effdesc ~%effdesc%~^~（错误的类型代码）~ SPRINT idsentry ~~
		END
		SPRINT effdesc ~%effdesc%~^~%idsentry%~
		LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
	END
	PATCH_IF opcode == 111 BEGIN
		LPF SCRAMBLED_TEXT_NAMECHECK INT_VAR showname = (detailed > 2 ? 1 : 2 ) STR_VAR itmcode = EVAL ~%readres%~ RET namestr END
		PATCH_IF ((~%namestr%~ STRING_CONTAINS_REGEXP ~不存在的物品~)&&((~%namestr%~ STRING_CONTAINS_REGEXP ~未知物品~)||(detailed > 0))) BEGIN
			SPRINT effdesc ~%effdesc%~^~产生魔法武器：%namestr%，数量%readamount%~ SET descfixed = 1
			LPF APPEND_EFFECT_DESC INT_VAR aopcode = opcode alocation = location afirsteff = firsteff aeffectnum = effectnum STR_VAR adesc = EVAL ~%effdesc%~ RET effdesc = anewdesc END
		END
